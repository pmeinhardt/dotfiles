#!/bin/sh
#
# Usage: targz <path> [archive-name]
# Description: create a gzipped tar archive
#

targz () {
  if [ -z "$1" ]; then
    echo "Usage: targz <path> [archive-name]" 1>&2
    return 1
  fi

  source_path="$1"
  if [ ! -e "$source_path" ]; then
    echo "'$source_path' does not exist" 1>&2
    return 1
  fi

  if [ -n "$2" ]; then
    archive_name="$2"
  else
    archive_name="$(basename "${source_path%/}")"
  fi

  source_name="$(basename "${source_path%/}")"
  source_dir="$(cd "$(dirname "$source_path")" && pwd)"

  tar -czvf "${archive_name}.tar.gz" -C "$source_dir" "$source_name"
}
