# Usage: targz <path> [archive-name]
# Description: create a gzipped tar archive
#

targz () {
  if [ -z "$1" ]; then
    echo "Usage: targz <path> [archive-name]" 1>&2
    return 1
  fi

  source_path="$1"
  if [ ! -e "$source_path" ]; then
    echo "'$source_path' does not exist" 1>&2
    return 1
  fi

  source_name="$(basename "${source_path%/}")"
  case "$source_path" in
    */*) source_parent="$(dirname "$source_path")" ;;
    *) source_parent="$PWD" ;;
  esac

  if [ "$source_parent" = "$PWD" ]; then
    source_dir="$PWD"
  elif ! source_dir="$(cd "$source_parent" && pwd)"; then
    echo "Unable to read parent directory for '$source_path'" 1>&2
    return 1
  fi

  default_archive_name="$source_name"
  if [ "$default_archive_name" = "." ] || [ "$default_archive_name" = ".." ]; then
    default_archive_name="$(basename "$source_dir")"
  fi

  archive_name="${2:-$default_archive_name}"

  case "$archive_name" in
    */*) archive_path="$archive_name" ;;
    *) archive_path="$PWD/$archive_name" ;;
  esac

  case "$archive_path" in
    *.tar.gz|*.tgz) ;;
    *) archive_path="${archive_path}.tar.gz" ;;
  esac

  case "$archive_path" in
    /*) archive_path_abs="$archive_path" ;;
    *) archive_path_abs="$PWD/$archive_path" ;;
  esac

  if [ -d "$source_path" ]; then
    source_abs="$(cd "$source_dir" && cd "$source_name" && pwd)"
    case "$archive_path_abs" in
      "$source_abs"/*|"$source_abs")
        archive_path_abs="$(dirname "$source_abs")/${default_archive_name}.tar.gz"
        ;;
    esac
  fi

  tar -czvf "$archive_path_abs" -C "$source_dir" "$source_name"
}
