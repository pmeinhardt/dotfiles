# Usage: ta [session]
# Description: attach to a tmux session, creating it when needed
#

ta () {
  if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux is not installed" 1>&2
    return 1
  fi

  session_name="${1:-main}"

  if [ -n "$TMUX" ]; then
    if tmux has-session -t "$session_name" 2>/dev/null || tmux new-session -d -s "$session_name"; then
      tmux switch-client -t "$session_name"
      return $?
    fi
    return 1
  else
    if tmux has-session -t "$session_name" 2>/dev/null; then
      tmux attach-session -t "$session_name"
    else
      tmux new-session -s "$session_name"
    fi
    return $?
  fi
}
