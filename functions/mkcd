# Usage: mkcd <directory>
# Description: create a directory (including parents) and enter it
#

mkcd () {
  if [ -z "$1" ]; then
    echo "Usage: mkcd <directory>" 1>&2
    return 1
  fi

  directory_path="$1"
  while [ "$directory_path" != "/" ] && [ "${directory_path%/}" != "$directory_path" ]; do
    directory_path="${directory_path%/}"
  done

  if [ -e "$directory_path" ] && [ ! -d "$directory_path" ]; then
    echo "'$directory_path' exists and is not a directory" 1>&2
    return 1
  fi

  if [ -d "$directory_path" ]; then
    builtin cd "$directory_path"
  else
    mkdir -p "$directory_path" && builtin cd "$directory_path"
  fi
}
