# Improve color handling
set-option -g default-terminal "$TERM"

# Set terminal title
set-option -g set-titles on

# Increase scrollback lines
set-option -g history-limit 10000

# No delay when hitting escape
set-option -s escape-time 0

# Pass shift-enter and other such inputs to terminal apps like Vim/Neovim.
set-option -s extended-keys on

# Longer display time for tmux messages
set-option -g display-time 3000

# Change prefix
unbind-key C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# Emacs key bindings in command prompt
set-option -g status-keys emacs

# Use vim key bindings in copy mode
set-option -w -g mode-keys vi

# Enable focus events
set-option -g focus-events on

# Setup vim-like selection and yanking
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi V send-keys -X select-line
bind-key -T copy-mode-vi y send-keys -X copy-pipe 'pbcopy'

# Update default binding of Enter to also use copy-pipe
unbind-key -T copy-mode-vi Enter
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel 'pbcopy'

# Additional vim-like keybindings for pane-switching
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R

# Seamless pane navigation between tmux and Vim/Neovim
bind-key -n C-h if-shell '[ "#{pane_current_command}" = "nvim" ] || [ "#{pane_current_command}" = "vim" ]' 'send-keys C-h' 'select-pane -L'
bind-key -n C-j if-shell '[ "#{pane_current_command}" = "nvim" ] || [ "#{pane_current_command}" = "vim" ]' 'send-keys C-j' 'select-pane -D'
bind-key -n C-k if-shell '[ "#{pane_current_command}" = "nvim" ] || [ "#{pane_current_command}" = "vim" ]' 'send-keys C-k' 'select-pane -U'
bind-key -n C-l if-shell '[ "#{pane_current_command}" = "nvim" ] || [ "#{pane_current_command}" = "vim" ]' 'send-keys C-l' 'select-pane -R'

# Open selected URLs
bind-key -T copy-mode-vi x send-keys -X copy-pipe-and-cancel 'xargs -I {} tmux run-shell -b "cd #{pane_current_path}; open \"{}\" > /dev/null"'

# Open path in editor
bind-key -T copy-mode-vi C-o send-keys -X copy-pipe-and-cancel 'xargs -I {} tmux send-keys "$EDITOR \"{}\""'

# Alternate bindings for pane-splitting
bind-key \\ split-window -h -c '#{pane_current_path}'
bind-key - split-window -v -c '#{pane_current_path}'
bind-key | split-window -fh -c '#{pane_current_path}'
bind-key _ split-window -fv -c '#{pane_current_path}'

# Resize panes
bind-key -r H resize-pane -L 1
bind-key -r J resize-pane -D 1
bind-key -r K resize-pane -U 1
bind-key -r L resize-pane -R 1

# Preserve path for new windows
bind-key c new-window -c '#{pane_current_path}'

# Use [ and ] to cycle through windows
bind-key -r [ select-window -t :-
bind-key -r ] select-window -t :+

# Use < and > to move windows
bind-key -r < swap-window -t -1
bind-key -r > swap-window -t +1

# Move the built-in session and window trees out of the way
bind-key S choose-tree -Zs
bind-key W choose-tree -Zw

# Fuzzy-match session names and switch to the selected one
bind-key s display-popup -E -T ' sessions ' 'tmux list-sessions -F "#{session_name}" | fzf --reverse --preview "tmux capture-pane -ep -t {}" --preview-window "right,60%,nowrap,<80(up,50%,nowrap)" | xargs -I {} tmux switch-client -t {}'

# Fuzzy-match window names and switch to the selected one
bind-key w display-popup -E -T ' windows ' 'tmux list-windows -a -F "#{session_name}:#{window_index} #{window_name}" | fzf --reverse --preview "tmux capture-pane -ep -t {1}" --preview-window "right,60%,nowrap,<80(up,50%,nowrap)" | cut -d " " -f 1 | xargs -I {} tmux switch-client -t {}'

# Fuzzy-match project roots and open/switch coding sessions
bind-key P display-popup -E -T ' projects ' 'for root in ~/Code ~/code ~/src ~/work; do [ -d "$root" ] && find "$root" -mindepth 1 -maxdepth 4 -type d -name .git; done 2>/dev/null | sed "s#/.git\$##" | sort -u | fzf --reverse --preview "ls -la {}" --preview-window "right,60%,nowrap,<80(up,50%,nowrap)" | while IFS= read -r project; do [ -n "$project" ] || continue; base=$(basename "$project" | sed "s#[^A-Za-z0-9_.-]#_#g"); hash=$(printf "%s" "$project" | cksum | awk "{print \$1}"); session="${base}_${hash}"; tmux has-session -t "$session" 2>/dev/null || { editor="${EDITOR:-nvim}"; tmux new-session -d -s "$session" -c "$project"; tmux send-keys -t "$session" "$editor" Space . C-m; tmux split-window -t "$session" -v -c "$project"; tmux select-pane -t "$session" -U; tmux select-layout -t "$session" even-vertical; }; tmux switch-client -t "$session"; done'

# Zoom and scratch-terminal workflow
bind-key z resize-pane -Z
bind-key T display-popup -E -d '#{pane_current_path}' -w 85% -h 85% '$SHELL'

# Start window numbers at 1 to match keyboard order with tmux window order
set-option -g base-index 1
set-option -w -g pane-base-index 1

# Renumber windows sequentially after closing any of them
set-option -g renumber-windows on

# Customize status bar format for window information
set-option -g window-status-format ' #[fg=red]#{window_index}#[fg=default] #{window_name} #[fg=yellow]#{window_flags}#[default] '
set-option -g window-status-current-format '#[reverse]#{window_index} #{window_name} #{window_flags}#[noreverse]'
set-option -g window-status-separator ''

# Show prefix activation and copy mode in left status bar
set-option -g status-left '#{?client_prefix,#[fg=yellow],#{?pane_in_mode,#[fg=yellow],#[fg=default]}}#[fg=default] '

# Show session name in right status bar
set-option -g status-right '#{session_name}'

# Customize status bar colors
set-option -g status-style 'bg=#000000,fg=#5d5959'
set-option -g window-status-current-style 'fg=#a4a0a0'

# Customize border colors
set-option -g pane-border-style 'fg=#231f1f'
set-option -g pane-active-border-style 'fg=#5d5959'

# Conditionally load local config
if-shell '[ -f ~/.tmux.conf.local ]' 'source ~/.tmux.conf.local'

# Reload tmux config
bind-key R run-shell 'tmux source-file ~/.tmux.conf > /dev/null; tmux display-message "Sourced config"'
