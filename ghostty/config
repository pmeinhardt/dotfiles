# Font settings

font-family = "Source Code Pro"
font-feature = -calt

# Draw text with heavier strokes so colors stay vivid
font-thicken = true

# Add some space between lines
adjust-cell-height = 15%


# Colors
#
# 00 = black    08 = bright black
# 01 = red      09 = bright red
# 02 = green    10 = bright green
# 03 = yellow   11 = bright yellow
# 04 = blue     12 = bright blue
# 05 = purple   13 = bright purple
# 06 = cyan     14 = bright cyan
# 07 = white    15 = bright white

# Warm Mocha, a warmer, near-black Catppuccin Mocha (see colors/warm-mocha.html)

palette = 0=#4a484b
palette = 1=#f78c91
palette = 2=#c0dd8d
palette = 3=#fee0b0
palette = 4=#92b1fb
palette = 5=#fdc0d7
palette = 6=#9de2c6
palette = 7=#b1aeaa

palette = 8=#5e5c5e
palette = 9=#f7787d
palette = 10=#abd170
palette = 11=#f3cf92
palette = 12=#7fa5fd
palette = 13=#fcacca
palette = 14=#78d7b8
palette = 15=#c6c3bd

background = #0b0b0b
foreground = #dad7cf

selection-background = #4a484b
selection-foreground = #dad7cf

cursor-color = #f78c91
cursor-text = #0b0b0b

split-divider-color = #2c292b


# Background settings

background-opacity = 1


# Icon settings

macos-icon = custom-style
macos-icon-ghost-color = #cac9c8
macos-icon-screen-color = #101010


# Window settings

window-padding-balance = true
window-padding-x = 12
window-padding-y = 10
